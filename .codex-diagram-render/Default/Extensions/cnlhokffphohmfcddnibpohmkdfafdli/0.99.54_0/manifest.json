{
   "action": {
      "default_icon": {
         "128": "assets/icons/128.png",
         "16": "assets/icons/16.png",
         "19": "assets/icons/19.png",
         "24": "assets/icons/24.png",
         "32": "assets/icons/32.png",
         "38": "assets/icons/38.png",
         "48": "assets/icons/48.png",
         "60": "assets/icons/60.png"
      },
      "default_popup": "./popup.html",
      "default_title": "MultiPassword"
   },
   "background": {
      "service_worker": "background/background.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Ctrl+M",
            "mac": "Command+M"
         }
      },
      "open_popup": {
         "description": "Open extension popup",
         "suggested_key": {
            "default": "Ctrl+M",
            "mac": "Command+M"
         }
      }
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
      "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self';"
   },
   "default_locale": "en",
   "description": "__MSG_extDesc__",
   "externally_connectable": {
      "matches": [ "*://*.multipassword.com/*" ]
   },
   "homepage_url": "https://multipassword.com",
   "host_permissions": [ "https://*/*", "http://*/*" ],
   "icons": {
      "128": "assets/icons/128.png",
      "16": "assets/icons/16.png",
      "19": "assets/icons/19.png",
      "24": "assets/icons/24.png",
      "32": "assets/icons/32.png",
      "38": "assets/icons/38.png",
      "48": "assets/icons/48.png",
      "60": "assets/icons/60.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "88",
   "name": "__MSG_extName__",
   "permissions": [ "unlimitedStorage", "privacy", "activeTab", "browsingData", "clipboardWrite", "contextMenus", "scripting", "storage", "tabs", "offscreen", "webRequest" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.99.54",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "assets/icons/*.png", "save.html", "dropdownFrame.html", "autosaveNotificationFrame.html", "assets/fonts/*", "assets/images/*", "assets/styles/*", "injectContent/*", "injectContent/assets/*", "injectContent/assets/styles/*", "chunks/*" ]
   } ]
}
