runtime:
  mode: development
  provider_mode: fake
  gateway_port: 8642
  app_api_port: 8000
  web_port: 3000
  enable_web: true
  enable_telegram: false
  enable_workers: false
  enable_mcp: false

# Canonical Video Factory FastMCP stdio server definition
# When running with standard AIAgent, add this to ~/.hermes/config.yaml under mcp_servers:
mcp_servers:
  video_factory:
    command: "uv"
    args: ["run", "python", "-m", "hermes_personal.integrations.video_factory.server"]
