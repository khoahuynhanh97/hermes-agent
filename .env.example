# Hermes TikTok Video Factory - Configuration
# Copy this file to '.env' and fill in your details.

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_REVIEW_CHAT_ID=
TELEGRAM_REVIEW_SOURCE_CHAT=
TELEGRAM_REVIEW_DIRECTION=all
HERMES_ALERTS_ENABLED=0

# n8n Integration (Optional)
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# Video Search Provider API Keys (Optional)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI Video Provider API Keys (Optional)
# If a provider does not expose a stable public API yet, Hermes will still
# save copy-ready prompt packs for manual use.
GROK_API_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=
KREA_API_KEY=
LEONARDO_API_KEY=
AI_VIDEO_CUSTOM_API_KEY=

# AI Video Provider Endpoints / Models (Optional advanced overrides)
GROK_VIDEO_ENDPOINT=
RUNWAY_VIDEO_ENDPOINT=
PIKA_VIDEO_ENDPOINT=
KREA_VIDEO_ENDPOINT=
LEONARDO_VIDEO_ENDPOINT=
AI_VIDEO_CUSTOM_ENDPOINT=
GROK_VIDEO_MODEL=grok-imagine
RUNWAY_VIDEO_MODEL=gen4_turbo
PIKA_VIDEO_MODEL=pika-2.5
KREA_VIDEO_MODEL=auto
LEONARDO_VIDEO_MODEL=motion-2.0-fast
AI_VIDEO_CUSTOM_MODEL=video-model
AI_VIDEO_POLL_SECONDS=5
AI_VIDEO_MAX_WAIT_SECONDS=600

# System Paths (Optional, fallback is system PATH)
# Example: FFMPEG_PATH=C:\Users\TeamSol\ffmpeg\ffmpeg-master-latest-win64-gpl\bin\ffmpeg.exe
FFMPEG_PATH=

# Projects storage root directory
PROJECTS_ROOT=projects
