# Hermes TikTok Video Factory - Configuration
# Copy this file to '.env' and fill in your details.

# Canonical runtime data root. DBs/workspaces/exports/backups derive from here
# unless an explicit per-capability path is set.
HERMES_DATA_DIR=D:\work\hermes-agent-data

# Google Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Text LLM gateway. 9Router is the primary provider for chat and learning.
LLM_PROVIDER=router
LLM_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
LLM_ROUTER_API_KEY=
LLM_DEFAULT_MODEL=fast
# These values may be 9Router model aliases or concrete model IDs.
# Create the aliases in 9Router, or replace them with IDs from /v1/models.
LLM_MODEL_CHAT=fast
LLM_MODEL_LEARNING=reason
LLM_MODEL_CODE=code
LLM_TIMEOUT_SECONDS=60
LLM_RETRY_COUNT=1
LLM_ENABLE_LEGACY_PROVIDER_FALLBACK=1
HERMES_STORAGE_BACKEND=sqlite
HERMES_MAINTENANCE_REPORT_DIR=
TELEGRAM_MAX_FILE_MB=200

# Optional local TikTok/Douyin crawler. Keep this service on localhost only.
TIKTOK_CRAWLER_BASE_URL=http://127.0.0.1:5556
TIKTOK_CRAWLER_TIMEOUT_SECONDS=8
TIKTOK_MAX_CAROUSEL_IMAGES=20
TIKTOK_MAX_CAROUSEL_MB=50

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to use Hermes.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_REVIEW_CHAT_ID=
TELEGRAM_REVIEW_SOURCE_CHAT=
TELEGRAM_REVIEW_DIRECTION=all
HERMES_ALERTS_ENABLED=0

# Optional GitHub API token for higher repository-search rate limits.
# Leave empty to use GitHub's unauthenticated public API.
GITHUB_TOKEN=

# n8n Integration (Optional)
N8N_API_KEY=
N8N_BASE_URL=http://localhost:5678

# Video Search Provider API Keys (Optional)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI Video Provider API Keys (Optional)
# If a provider does not expose a stable public API yet, Hermes will still
# save copy-ready prompt packs for manual use.
GROK_API_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=
KREA_API_KEY=
LEONARDO_API_KEY=
AI_VIDEO_CUSTOM_API_KEY=

# Image generation (Video Factory storyboard frames)
# IMAGE_PROVIDER=fake (default, tests) | gemini | google_vertex
# Developer API (gemini):
#   IMAGE_MODEL=gemini-2.5-flash-image
#   GEMINI_API_KEY=<key> (reused from the Gemini block above)
# Google Cloud Vertex (google_vertex) - ADC/service-account auth, no key in code:
#   IMAGE_MODEL=gemini-2.5-flash-image (image models require a regional location)
#   GOOGLE_CLOUD_PROJECT=gen-lang-client-0816609628
#   GOOGLE_CLOUD_LOCATION=us-central1
IMAGE_PROVIDER=fake
IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_CLOUD_LOCATION=us-central1

# Video generation (Video Factory scene videos)
# VIDEO_PROVIDER=fake (default, tests) | google_vertex
# google_vertex requires Veo access granted on the project (preview/allowlist).
#   VIDEO_MODEL=veo-3.0-preview (or veo-3.1-preview)
#   GOOGLE_CLOUD_PROJECT=gen-lang-client-0816609628
#   GOOGLE_CLOUD_LOCATION=<required region, e.g. us-central1>
VIDEO_PROVIDER=fake
VIDEO_MODEL=veo-3.0-preview
VIDEO_POLL_SECONDS=15
VIDEO_MAX_WAIT_SECONDS=1800

# AI Video Provider Endpoints / Models (Optional advanced overrides)
GROK_VIDEO_ENDPOINT=
RUNWAY_VIDEO_ENDPOINT=
PIKA_VIDEO_ENDPOINT=
KREA_VIDEO_ENDPOINT=
LEONARDO_VIDEO_ENDPOINT=
AI_VIDEO_CUSTOM_ENDPOINT=
GROK_VIDEO_MODEL=grok-imagine
RUNWAY_VIDEO_MODEL=gen4_turbo
PIKA_VIDEO_MODEL=pika-2.5
KREA_VIDEO_MODEL=auto
LEONARDO_VIDEO_MODEL=motion-2.0-fast
AI_VIDEO_CUSTOM_MODEL=video-model
AI_VIDEO_POLL_SECONDS=5
AI_VIDEO_MAX_WAIT_SECONDS=600

# System Paths (Optional, fallback is system PATH)
# Example: FFMPEG_PATH=C:\Users\TeamSol\ffmpeg\ffmpeg-master-latest-win64-gpl\bin\ffmpeg.exe
FFMPEG_PATH=

# Projects storage root directory
PROJECTS_ROOT=projects
